<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="26,0,26,22">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
    <Button x:Name="Back" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="←  All clips" Padding="0,7,14,7"/>
    <TextBlock x:Name="ClipName" DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
    <Button x:Name="Delete" DockPanel.Dock="Right" Style="{StaticResource Danger}" Content="Delete"/>
    <Button x:Name="ShowInFolder" DockPanel.Dock="Right" Content="Show in folder" Margin="0,0,8,0"/>
    <Button x:Name="CopyClip" DockPanel.Dock="Right" Content="Copy" Margin="0,0,8,0" ToolTip="Copies the clip so you can paste it into Discord, a chat or a folder."/>
    <Button x:Name="FitDiscord" DockPanel.Dock="Right" Content="Fit for Discord" Margin="0,0,8,0" ToolTip="Makes a smaller copy of the selected part that fits Discord's upload limit, and copies it."/>
  </DockPanel>

  <Border Grid.Row="1" Background="#000000" CornerRadius="14" ClipToBounds="True">
    <Grid>
      <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True" Stretch="Uniform"/>
    </Grid>
  </Border>

  <Border x:Name="TimelineHost" Grid.Row="2" Height="56" Margin="0,14,0,0"/>

  <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
    <Button x:Name="PlayPause" DockPanel.Dock="Left" Width="44" Content="▶"/>
    <TextBlock x:Name="Time" DockPanel.Dock="Left" Foreground="#8C8C8C" VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Consolas" Text="0:00.0 / 0:00.0"/>
    <Button x:Name="SetStart" DockPanel.Dock="Left" Content="[  Set start" Margin="24,0,0,0"/>
    <Button x:Name="SetEnd" DockPanel.Dock="Left" Content="Set end  ]" Margin="8,0,0,0"/>
    <Button x:Name="ResetRange" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Reset" Margin="4,0,0,0"/>
    <Button x:Name="Export" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Save trimmed clip"/>
    <CheckBox x:Name="Exact" DockPanel.Dock="Right" Content="Exact cut" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Exact: cuts on the exact frame (re-encodes on your GPU). Off: instant, but cuts to the nearest second."/>
    <TextBlock x:Name="Selection" DockPanel.Dock="Right" Foreground="#8C8C8C" VerticalAlignment="Center" Margin="0,0,18,0" FontFamily="Consolas"/>
  </DockPanel>

  <TextBlock x:Name="EditStatus" Grid.Row="4" Foreground="#8C8C8C" Margin="0,10,0,0" TextWrapping="Wrap"/>
</Grid>
