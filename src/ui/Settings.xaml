<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="26,4,26,26" MaxWidth="760" HorizontalAlignment="Left">
    <DockPanel Margin="0,0,0,16" LastChildFill="False">
      <Button x:Name="Back" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="←  All clips" Padding="0,7,14,7"/>
      <TextBlock DockPanel.Dock="Left" Text="Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
      <Button x:Name="SaveTop" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Save settings"/>
    </DockPanel>

    <!-- ============ Clips & shortcuts ============ -->
    <Border Style="{StaticResource Section}">
      <StackPanel>
        <TextBlock Text="Clips and shortcuts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TextBlock Text="Clip lengths" FontWeight="SemiBold"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap"
                   Text="Seconds, separated by commas (5 to 300). Use 2m for minutes. Add @shortcut to give a length its own key, e.g.  15, 30, 2m@Alt+F10"/>
        <TextBox x:Name="Lengths"/>

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Save clip" FontWeight="SemiBold"/>
            <TextBox x:Name="KeySave" IsReadOnly="True" Cursor="Hand" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Pause / resume" FontWeight="SemiBold"/>
            <TextBox x:Name="KeyPause" IsReadOnly="True" Cursor="Hand" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Mute microphone" FontWeight="SemiBold"/>
            <TextBox x:Name="KeyMic" IsReadOnly="True" Cursor="Hand" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Text="Open LiteClip" FontWeight="SemiBold"/>
            <TextBox x:Name="KeyOpen" IsReadOnly="True" Cursor="Hand" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="KeyNote" Foreground="#8C8C8C" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Click a box and press the keys. Backspace clears it."/>
      </StackPanel>
    </Border>

    <!-- ============ Video ============ -->
    <Border Style="{StaticResource Section}">
      <StackPanel>
        <TextBlock Text="Video" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TextBlock Text="Monitor" FontWeight="SemiBold"/>
        <Border Background="#0F0F0F" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,8,0,0">
          <WrapPanel x:Name="Monitors"/>
        </Border>

        <TextBlock Text="Resolution" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="Native is the lightest (all on the graphics card). Lower resolutions make smaller files but use some CPU."/>
        <Border Background="#0F0F0F" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
          <WrapPanel x:Name="Resolutions"/>
        </Border>

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Frame rate" FontWeight="SemiBold"/>
            <Border Background="#0F0F0F" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,8,0,0">
              <WrapPanel x:Name="Fps"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Custom fps" FontWeight="SemiBold"/>
            <TextBox x:Name="FpsCustom" Width="90" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="Codec" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="H.264 plays everywhere. HEVC and AV1 make smaller files at the same quality (AV1 needs a newer graphics card and player)."/>
        <Border Background="#0F0F0F" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
          <WrapPanel x:Name="Codecs"/>
        </Border>

        <TextBlock Text="Encoder" FontWeight="SemiBold" Margin="0,18,0,8"/>
        <Border Background="#0F0F0F" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
          <WrapPanel x:Name="Encoders"/>
        </Border>

        <DockPanel Margin="0,18,0,0">
          <TextBlock x:Name="QualityValue" DockPanel.Dock="Right" Foreground="#8C8C8C" FontFamily="Consolas"/>
          <TextBlock Text="Quality" FontWeight="SemiBold"/>
        </DockPanel>
        <DockPanel Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Left" Text="Best" Foreground="#8C8C8C" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock DockPanel.Dock="Right" Text="Smallest" Foreground="#8C8C8C" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <Slider x:Name="Quality" Minimum="15" Maximum="40" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"/>
        </DockPanel>

        <CheckBox x:Name="Cursor" Content="Show the mouse cursor in clips" Margin="0,18,0,0"/>
      </StackPanel>
    </Border>

    <!-- ============ Audio ============ -->
    <Border Style="{StaticResource Section}">
      <StackPanel>
        <TextBlock Text="Audio" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <CheckBox x:Name="Game" Content="Record game and system sound"/>
        <DockPanel Margin="44,10,0,0">
          <TextBlock x:Name="GameVolValue" DockPanel.Dock="Right" Foreground="#8C8C8C" FontFamily="Consolas" Width="48" TextAlignment="Right"/>
          <Slider x:Name="GameVol" Minimum="0" Maximum="200" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"/>
        </DockPanel>

        <CheckBox x:Name="Mic" Content="Record my microphone" Margin="0,18,0,0"/>
        <DockPanel Margin="44,10,0,0">
          <TextBlock x:Name="MicVolValue" DockPanel.Dock="Right" Foreground="#8C8C8C" FontFamily="Consolas" Width="48" TextAlignment="Right"/>
          <Slider x:Name="MicVol" Minimum="0" Maximum="200" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"/>
        </DockPanel>
        <TextBlock Text="Microphone" Foreground="#8C8C8C" Margin="44,12,0,6"/>
        <StackPanel x:Name="MicDevices" Margin="44,0,0,0"/>
        <CheckBox x:Name="MicMuted" Content="Muted (records silence instead of your voice)" Margin="44,12,0,0"/>

        <CheckBox x:Name="Separate" Content="Keep game sound and microphone on separate tracks (for video editors)" Margin="0,18,0,0"/>
      </StackPanel>
    </Border>

    <!-- ============ Files ============ -->
    <Border Style="{StaticResource Section}">
      <StackPanel>
        <TextBlock Text="Files" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TextBlock Text="Clips folder" FontWeight="SemiBold"/>
        <DockPanel Margin="0,8,0,0">
          <Button x:Name="ChangeFolder" DockPanel.Dock="Right" Content="Change" Margin="8,0,0,0"/>
          <TextBox x:Name="FolderBox" IsReadOnly="True"/>
        </DockPanel>

        <TextBlock Text="File name" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="Use {app} (the game or app you were in), {date}, {time}, {length}."/>
        <TextBox x:Name="FileName"/>
        <TextBlock x:Name="FileNamePreview" Foreground="#8C8C8C" Margin="0,6,0,0" FontFamily="Consolas"/>

        <TextBlock Text="Clean up old clips" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="Old clips go to the Recycle Bin, so you can still get them back. 0 = never."/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Keep for" VerticalAlignment="Center"/>
          <TextBox x:Name="KeepDays" Width="70" Margin="10,0,8,0"/>
          <TextBlock Text="days    and at most" VerticalAlignment="Center"/>
          <TextBox x:Name="MaxGB" Width="70" Margin="10,0,8,0"/>
          <TextBlock Text="GB" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="Fit for Discord" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="The size the editor's Fit for Discord button aims for. 10 = Discord's free limit, 50 = Nitro Basic, 500 = Nitro."/>
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="ShareLimit" Width="70"/>
          <TextBlock Text="MB" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ============ Look & feel ============ -->
    <Border Style="{StaticResource Section}">
      <StackPanel>
        <TextBlock Text="Look and feel" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <CheckBox x:Name="Toast" Content="Show a pop-up when a clip is saved"/>
        <CheckBox x:Name="Sound" Content="Play a short sound when a clip is saved" Margin="0,14,0,0"/>
        <TextBlock Text="Accent colour" FontWeight="SemiBold" Margin="0,18,0,8"/>
        <StackPanel Orientation="Horizontal">
          <WrapPanel x:Name="Swatches"/>
          <TextBox x:Name="AccentBox" Width="110" Margin="10,0,0,0" FontFamily="Consolas"/>
        </StackPanel>

        <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="Add your own: copy lang\template.txt, fill in the translations, save it as lang\YourLanguage.txt."/>
        <Border Background="#0F0F0F" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
          <WrapPanel x:Name="Languages"/>
        </Border>
        <Button x:Name="OpenLang" Style="{StaticResource Ghost}" Content="Open language folder" HorizontalAlignment="Left" Padding="0,7,14,7" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <!-- ============ Advanced ============ -->
    <Border Style="{StaticResource Section}">
      <StackPanel>
        <TextBlock Text="Advanced" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <CheckBox x:Name="Startup" Content="Start with Windows (runs quietly in the tray)"/>

        <TextBlock Text="Run after saving" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap"
                   Text="Optional command to run after each clip, {file} = the clip. Example:  explorer /select,{file}   Only put commands here that you trust."/>
        <TextBox x:Name="AfterSave" FontFamily="Consolas"/>

        <TextBlock Text="Recording buffer folder" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="Where the rolling last-few-minutes recording is kept. Empty = Windows' temp folder. Pick a fast drive if you like."/>
        <DockPanel>
          <Button x:Name="ChangeBuffer" DockPanel.Dock="Right" Content="Change" Margin="8,0,0,0"/>
          <Button x:Name="DefaultBuffer" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Default" Margin="8,0,0,0"/>
          <TextBox x:Name="BufferBox" IsReadOnly="True"/>
        </DockPanel>

        <TextBlock Text="Encoder frames in memory (NVIDIA)" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="Each frame the graphics card keeps ready uses about 11 MB of RAM at 1440p. 1 = lightest, 4 = safest in very heavy games."/>
        <Border Background="#0F0F0F" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
          <WrapPanel x:Name="GpuFrames"/>
        </Border>

        <TextBlock Text="Custom encoder options" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="For FFmpeg experts. Replaces LiteClip's video encoder options, e.g.  -c:v hevc_nvenc -preset p7 -cq 20   Leave empty for normal. If recording stops working, empty this box."/>
        <TextBox x:Name="CustomArgs" FontFamily="Consolas"/>

        <TextBlock Text="FFmpeg command LiteClip runs right now" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap" Text="Nothing hidden: this is exactly how your screen and sound are being recorded."/>
        <TextBox x:Name="Command" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#B0B0B0"/>
        <Button x:Name="CopyCommand" Style="{StaticResource Ghost}" Content="Copy command" HorizontalAlignment="Left" Padding="0,7,14,7" Margin="0,4,0,0"/>

        <TextBlock Text="Portable mode" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock x:Name="PortableText" Foreground="#8C8C8C" Margin="0,3,0,8" TextWrapping="Wrap"/>
        <Button x:Name="TogglePortable" HorizontalAlignment="Left"/>

        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
          <Button x:Name="OpenIni" Content="Open settings file"/>
          <Button x:Name="ResetAll" Style="{StaticResource Danger}" Content="Reset everything" Margin="8,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
      <Button x:Name="SaveSettings" Style="{StaticResource Primary}" Content="Save settings"/>
      <TextBlock x:Name="SettingsStatus" Foreground="#8C8C8C" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="560"/>
    </StackPanel>

    <Border Style="{StaticResource Section}" Margin="0,24,0,14">
      <StackPanel>
        <TextBlock Text="About" FontWeight="SemiBold"/>
        <TextBlock x:Name="About" Foreground="#8C8C8C" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Section}">
      <StackPanel>
        <TextBlock Text="Remove LiteClip" FontWeight="SemiBold"/>
        <TextBlock Foreground="#8C8C8C" Margin="0,3,0,10" TextWrapping="Wrap"
                   Text="Deletes everything LiteClip made on this PC: settings, thumbnails, temporary files, the recording buffer, the start-with-Windows shortcut and its program files. Your clips are kept."/>
        <Button x:Name="Uninstall" Style="{StaticResource Danger}" Content="Remove LiteClip from this PC" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
  </StackPanel>
</ScrollViewer>
