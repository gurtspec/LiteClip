<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0B0B0B">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- Header -->
  <DockPanel Grid.Row="0" Margin="26,20,26,14" LastChildFill="False">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse x:Name="RecDot" Width="11" Height="11" Fill="#FF4D4D" Margin="0,2,10,0"/>
      <TextBlock Text="LiteClip" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="Status" Text="Starting…" Foreground="#8C8C8C" Margin="14,7,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="Clip length" Foreground="#8C8C8C" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <Border Background="#141414" CornerRadius="10" Padding="3">
        <!-- filled in from your clip lengths (Settings) -->
        <StackPanel x:Name="LenPanel" Orientation="Horizontal"/>
      </Border>
      <Button x:Name="SaveNow" Style="{StaticResource Primary}" Margin="16,0,0,0" Content="Save clip"/>
      <Button x:Name="OpenFolder" Margin="8,0,0,0" Content="Folder"/>
      <Button x:Name="OpenSettings" Margin="8,0,0,0" Content="Settings"/>
    </StackPanel>
  </DockPanel>

  <ContentControl x:Name="Body" Grid.Row="1"/>
</Grid>
